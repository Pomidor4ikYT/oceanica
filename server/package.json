{
  "name": "oceanica-api",
  "version": "1.0.0",
  "private": true,
  "description": "Oceanica API Server with PostgreSQL support",
  "main": "server.js",
"scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",
  "db:init": "node database/init-pg.js",
  "db:migrate": "node database/migration.js",
  "db:seed": "node database/seed-pg.js",
  "postinstall": "npm run db:init"
},
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}